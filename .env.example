# ==========================================================================
#  Cuquora · plantilla de configuración para docker compose.
#  Copia este fichero a .env y rellénalo:   cp .env.example .env
#  El .env tiene las contraseñas reales y NO se sube a git.
# ==========================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=crm_cbelleza
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=cambia-esta-contraseña

# --- Correo con Brevo (SMTP). Vacío = los correos se escriben en la consola ---
# Brevo > SMTP y API > SMTP: servidor smtp-relay.brevo.com, puerto 587, usuario = «Login» de SMTP
# y contraseña = una «Clave SMTP» generada allí (no la contraseña de la cuenta).
# CRM_FROM_EMAIL tiene que ser un remitente verificado en Brevo (mejor del dominio, con SPF/DKIM/DMARC).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Con dominio propio, mejor direcciones del dominio (p. ej. hola@cuquora.com y citas@cuquora.com):
# enviar «desde» un hotmail o gmail con Brevo hace que muchos correos acaben en spam.
CRM_ADMIN_EMAIL=cuquora@hotmail.com
CRM_FROM_EMAIL=cuquora@hotmail.com

# --- Seguridad ---
# Firma la cookie «Recordar mi sesión» (mínimo 32 caracteres). Genera una con:  openssl rand -base64 48
REMEMBER_ME_KEY=

# --- Iniciar sesión con Google (opcional; vacías = sin botón de Google) ---
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth (Aplicación web).
# URI de redirección autorizada: https://<tu-dominio>/login/oauth2/code/google
# (y http://localhost:8080/login/oauth2/code/google para pruebas en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Calendar (interruptor en «Mi Centro»): mismo ID de cliente, con la API de Google Calendar activada
# y la URI https://<tu-dominio>/worker/google-calendar/callback también autorizada.
# Clave para cifrar los tokens de Google en la base de datos. Vacía = sin sincronización.
# Genera una con:  openssl rand -base64 48   (si la cambias, los trabajadores tendrán que volver a activarla)
GOOGLE_TOKEN_KEY=

# --- API de productos (contenedor product-api) ---
# Clave que comparten la app y la API de productos (mínimo 32 caracteres). Genera una con:  openssl rand -hex 32
PRODUCT_API_KEY=
# Contraseña del usuario propio de la API de productos en PostgreSQL (productos_api, lo crea el servicio db-setup).
# Mínimo 16 caracteres. Genera una con:  openssl rand -hex 24
PRODUCT_API_DB_PASSWORD=
# false = la API no consulta Open Beauty Facts y solo sabe lo que dan de alta los centros
# OPEN_BEAUTY_FACTS_ENABLED=true

# --- Cloudflare Tunnel (solo en el servidor) ---
# Zero Trust > Networks > Tunnels > Create a tunnel (Cloudflared) > copia el token del comando que te enseña
# (lo que va detrás de «--token»). En «Public hostname»: cuquora.com, servicio HTTP, URL app:8080.
COMPOSE_PROFILES=cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# --- Sitio ---
# Dirección pública con https:// y sin barra final: https://cuquora.com OBLIGATORIA: con ella se escriben
# los enlaces de los correos, el enlace corto /c/<nombre>, el QR del cartel, las vistas previas al compartir y el sitemap.
SITE_URL=
# docker compose arranca con el perfil de producción (prod): HTTPS, cookies seguras, IP real desde Cloudflare y
# una revisión que no deja arrancar si falta algo de este fichero. Para PROBAR EN LOCAL por http://localhost:8080,
# pon SITE_URL=http://localhost:8080, borra COMPOSE_PROFILES y quita el # de estas tres líneas (en el servidor, nunca):
# SPRING_PROFILES_ACTIVE=
# COOKIE_SECURE=false
# FORWARD_HEADERS_STRATEGY=none
# La app solo escucha en 127.0.0.1:8080. Para abrirla a otros equipos de tu red (nunca con native): APP_BIND=0.0.0.0
# APP_BIND=0.0.0.0
# Zona horaria del servidor (hora de las citas). Por defecto Europe/Madrid
# TZ=Europe/Madrid

# --- Titular de la web (aparece en Términos y Privacidad; lo exige la LSSI) ---
LEGAL_OWNER_NAME=
LEGAL_OWNER_NIF=
LEGAL_OWNER_ADDRESS=

# Cuentas demo con contraseña pública "Cuquora2026!". Nunca true en producción.
SEED_DEMO_DATA=false
